# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already in .gitignore.
# ============================================================

# ---------- Database (needed now, Phase 1) ----------
# Full Postgres connection string.
# Get one free from neon.tech, supabase.com, or railway.app —
# create a Postgres project on any of them and copy the connection string here.
DATABASE_URL="postgresql://user:password@host:5432/freefire_esports"

# ---------- Server (needed now, Phase 1) ----------
PORT=3000
NODE_ENV=development

# ---------- Firebase Admin (wired in during Phase 2 — create the project now) ----------
# Firebase Console → Project Settings → Service Accounts → Generate new private key.
# That downloads a JSON file containing these three values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- Admin panel auth (wired in during Phase 7) ----------
ADMIN_JWT_SECRET=replace_with_a_long_random_string

# ---------- CORS (Phase 11 — optional, unset = allow all) ----------
# Comma-separated list of allowed origins for production, e.g.:
# ALLOWED_ORIGINS=https://admin.yourapp.com,https://yourapp.com
# Leave unset for local development — the Android app doesn't send an
# Origin header anyway, so this only matters for the browser-based admin panel.
ALLOWED_ORIGINS=

# ---------- Push notifications (wired in during Phase 10) ----------
# Uses the same Firebase project as above — no separate key needed.
