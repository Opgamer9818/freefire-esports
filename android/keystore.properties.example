# Copy this file to keystore.properties (same folder) and fill in real values.
# keystore.properties is gitignored — never commit your real signing key or passwords.
#
# Generate a keystore first (from the android/ folder):
#   keytool -genkeypair -v -keystore release.keystore -alias freefireesports -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=release.keystore
storePassword=replace_with_your_keystore_password
keyAlias=freefireesports
keyPassword=replace_with_your_key_password
