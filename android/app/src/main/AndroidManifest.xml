<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FreeFireEsportsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FreeFireEsports"
        android:usesCleartextTraffic="true">

        <!-- usesCleartextTraffic is only needed for http://10.0.2.2 during
             local development against the emulator. Remove it once the
             backend is deployed behind HTTPS (Phase 11 / release). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FreeFireEsports">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".notification.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
